NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Malami (B1.3): where the Ollama server is and which model to ask for.
# Read on the server only, so no NEXT_PUBLIC_ prefix. These are the built-in defaults;
# leave both out and you get the same values.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Set to 'true' in Vercel production to show the coming soon overlay
# Leave unset or 'false' in local development
NEXT_PUBLIC_COMING_SOON=true
