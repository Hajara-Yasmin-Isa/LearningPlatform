NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Set to 'true' in Vercel production to show the coming soon overlay
# Leave unset or 'false' in local development
NEXT_PUBLIC_COMING_SOON=true
# Set to 'true' to turn on the Malamin AI chat page and its Header link.
# Leave unset or 'false' in production until the feature is signed off.
NEXT_PUBLIC_MALAMI=false
